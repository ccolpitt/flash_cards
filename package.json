{
    "name": "flashcard-app",
    "version": "0.0.1",
    "description": "A flashcard learning application with spaced repetition and intelligent card orchestration",
    "type": "module",
    "main": "dist/index.js",
    "scripts": {
        "build": "tsc",
        "start": "tsx src/index.ts",
        "api": "tsx api/server.ts",
        "web": "vite --config web/vite.config.ts",
        "dev": "concurrently \"npm run api\" \"npm run web\"",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "dependencies": {
        "cors": "^2.8.6",
        "express": "^5.2.1",
        "react": "^19.2.5",
        "react-dom": "^19.2.5",
        "react-router-dom": "^7.14.2",
        "uuid": "^11.1.0"
    },
    "devDependencies": {
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/node": "^25.6.0",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@types/uuid": "^10.0.0",
        "@vitejs/plugin-react": "^4.7.0",
        "concurrently": "^9.2.1",
        "fast-check": "^3.23.2",
        "tsx": "^4.21.0",
        "typescript": "^5.7.0",
        "vitest": "^3.1.0"
    }
}
